# ============================================================
# Despina Pharma API
# ============================================================
NODE_ENV=development
PORT=3000
# Public URL of the website/dashboard (used in email links)
APP_URL=http://localhost:3001
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3001
# Long random string used to sign invite/reset/upload/download tokens (32+ chars). Keep secret.
APP_SECRET=
SWAGGER_ENABLED=true

# ---------------- Database (Clever Cloud PostgreSQL) ----------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Max database connections for this app (Clever Cloud limit is 5 in total)
DB_POOL_MAX=2
DB_SSL=false

# ---------------- Auth ----------------
SESSION_TTL_DAYS=7
# Staff must turn on two-factor login (the login response flags mfaSetupRequired)
REQUIRE_STAFF_MFA=true
MFA_ISSUER=Despina Pharma
# First admin, created by `npm run seed` only if no admin exists (10+ char password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- Email ----------------
# NOTE: EMAIL SENDING IS NOT CONNECTED YET – it will be done with Resend later.
# While EMAIL_PROVIDER=none every email is saved in the email_jobs table (status "queued")
# and only logged to the console; nothing is sent. Once Resend is added, the queued
# emails will be sent automatically.
# TODO(resend): set EMAIL_PROVIDER=resend and fill in the values below
#   (see src/email/email.provider.ts for the steps).
EMAIL_PROVIDER=none
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Sender address on the company domain (domain needs SPF, DKIM and DMARC in Resend)
EMAIL_FROM=Despina Pharma <no-reply@despinapharma.com>
EMAIL_REPLY_TO=
# Keep false until the Resend webhook signature check is implemented
EMAIL_WEBHOOK_ENABLED=false
EMAIL_WORKER_INTERVAL_SECONDS=30
# Who receives new-inquiry notices (comma-separated)
OWNER_NOTIFICATION_EMAIL=
# Optional per-form recipients, e.g. NOTIFY_SAMPLE_REQUEST=lab@despinapharma.com
NOTIFY_CONTACT=
NOTIFY_NEW_CUSTOMER=
NOTIFY_NEW_PRODUCT=
NOTIFY_SAMPLE_REQUEST=
NOTIFY_SAMPLE_FEEDBACK=
NOTIFY_SERVICE=

# ---------------- Uploads ----------------
# local disk for now (TODO: s3/r2 for production)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
UPLOAD_MAX_FILES=5
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.docx,.xlsx
# manual = files stay "pending" until staff release them; skip = mark clean (dev only). TODO: ClamAV
SCAN_MODE=manual
DOWNLOAD_LINK_TTL_SECONDS=300

# ---------------- Limits & reminders ----------------
INQUIRY_RATE_LIMIT_PER_HOUR=20
# Hour (0-23, server time) when the daily overdue-task email goes out
TASK_REMINDER_HOUR=8

# ---------------- Seed ----------------
CATALOG_DATA_PATH=../Despina-Pharma-IT-Package/project/catalog-data.json

# ---------------- Added ----------------
API_PUBLIC_URL=http://localhost:3000
EMAIL_INBOUND_ENABLED=false
